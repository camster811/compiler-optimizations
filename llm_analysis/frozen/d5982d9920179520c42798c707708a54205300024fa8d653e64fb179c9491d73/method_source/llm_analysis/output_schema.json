{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["classification", "predicted_cwe", "confidence", "evidence", "summary", "uncertainty_reason"],
  "properties": {
    "classification": {"enum": ["vulnerable", "not_vulnerable", "uncertain"]},
    "predicted_cwe": {"enum": ["CWE-121", "CWE-122", null]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 12, "items": {
      "type": "object", "additionalProperties": false, "required": ["addresses", "observation"],
      "properties": {
        "addresses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^0x[0-9a-f]+$"}},
        "observation": {"type": "string", "minLength": 1, "maxLength": 400}
      }
    }},
    "summary": {"type": "string", "minLength": 1, "maxLength": 600},
    "uncertainty_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 600}
  },
  "allOf": [
    {"if": {"properties": {"classification": {"const": "vulnerable"}}},
     "then": {"properties": {"predicted_cwe": {"enum": ["CWE-121", "CWE-122"]}}},
     "else": {"properties": {"predicted_cwe": {"type": "null"}}}},
    {"if": {"properties": {"classification": {"const": "uncertain"}}},
     "then": {"properties": {"uncertainty_reason": {"type": "string"}}},
     "else": {"properties": {"uncertainty_reason": {"type": "null"}}}}
  ]
}
