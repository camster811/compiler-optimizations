{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ghidra region record (analyzer-facing)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_id", "status", "function", "decompilation",
               "instructions", "calls", "tail_jumps", "constants", "stack_variables", "imports"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sample_id": {"type": "string", "pattern": "^sample_[0-9]{4}$"},
    "status": {"enum": ["ok", "function_not_found"]},
    "function": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "entry", "size_bytes", "instruction_count", "basic_block_count", "body_ranges"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "entry": {"$ref": "#/$defs/hex"},
            "size_bytes": {"type": "integer", "minimum": 1},
            "instruction_count": {"type": "integer", "minimum": 1},
            "basic_block_count": {"type": "integer", "minimum": 1},
            "body_ranges": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {"$ref": "#/$defs/hex"}
              }
            }
          }
        }
      ]
    },
    "decompilation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "text", "error"],
      "properties": {
        "status": {"enum": ["ok", "failed", "timeout"]},
        "text": {"type": ["string", "null"]},
        "error": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "ok"}}},
          "then": {"properties": {"text": {"type": "string", "minLength": 1}, "error": {"type": "null"}}},
          "else": {"properties": {"text": {"type": "null"}, "error": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "instructions": {"type": "array", "items": {"type": "string", "pattern": "^0x[0-9a-f]+: .+"}},
    "calls": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tail_jumps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "constants": {"type": "array", "items": {"type": "string", "pattern": "^-?[0-9]+$"}, "uniqueItems": true},
    "stack_variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "stack_offset", "size_bytes", "data_type"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "stack_offset": {"type": "integer"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "data_type": {"type": "string", "minLength": 1}
        }
      }
    },
    "imports": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ok"}}},
      "then": {"properties": {"function": {"type": "object"}, "instructions": {"minItems": 1}}},
      "else": {"properties": {"function": {"type": "null"}}}
    }
  ],
  "$defs": {
    "hex": {"type": "string", "pattern": "^0x[0-9a-f]+$"}
  }
}
